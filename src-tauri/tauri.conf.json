{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gym",
  "version": "0.1.1",
  "identifier": "com.oilyin.gym",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gym",
        "width": 1100,
        "height": 760,
        "minWidth": 680,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "reminder",
        "title": "Gym — пора размяться",
        "url": "index.html",
        "width": 400,
        "height": 540,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "focus": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Локальные напоминания о тренировках",
    "longDescription": "Gym напоминает о коротких тренировках, сохраняет результаты локально и работает без сети.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/sounds/workout-reminder.wav": "sounds/workout-reminder.wav"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
