{
  "name": "gym",
  "private": true,
  "version": "0.1.1",
  "description": "Локальное приложение для напоминаний о тренировках и их учёта",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:offline": "node scripts/check-offline-sources.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:linux": "npm run release:verify && npm run tauri build -- --bundles deb,appimage",
    "release:fedora": "npm run release:verify && npm run tauri build -- --bundles rpm,appimage",
    "release:macos": "npm run release:verify && npm run tauri build -- --target universal-apple-darwin --bundles app,dmg",
    "release:collect:linux": "node scripts/collect-release-artifacts.mjs linux",
    "release:collect:fedora": "node scripts/collect-release-artifacts.mjs fedora",
    "release:collect:macos": "node scripts/collect-release-artifacts.mjs macos",
    "lint": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:frontend && npm run test:rust",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:offline && npm run release:verify && npm run test && npm run lint:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
